{
  "name": "world1",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Turn-based semi-auto roguelite party battler",
  "scripts": {
    "dev": "vite",
    "build": "npm run content:verify && npm run content:validate && npm run build:run-executors && npm run typecheck && vite build",
    "preview": "vite preview",
    "deploy": "npm run deploy:prepare && npx --yes wrangler pages deploy dist --project-name=proof-of-concept-ab-deckbuilder --branch=main && npm run executors:approve-current -- --apply --wait",
    "pretest": "npm run content:verify && npm run build:run-executors",
    "test": "node scripts/check-boundaries.mjs && npm run typecheck && node scripts/check-skill-parity.mjs && npm run audit:pl && npm run audit:equipment && npm run audit:equipment-sources && npm run audit:equipment-battle && npm run audit:equipment-share && npm run audit:equipment-run && npm run audit:battle-passives",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.functions.json --noEmit && tsc -p tsconfig.community-worker.json --noEmit",
    "preapi": "npm run content:verify && npm run build:run-executors",
    "api": "tsx server/battleApi.ts",
    "fight": "tsx scripts/fight.ts",
    "sim": "tsx scripts/balance.ts",
    "output": "tsx scripts/enemyOutput.ts",
    "content:export": "tsx scripts/exportEnemies.ts && tsx scripts/exportModifiers.ts",
    "content:events": "tsx scripts/eventPackCompiler.ts",
    "content:validate": "tsx scripts/validateContent.ts",
    "content:wiki": "tsx scripts/generateEventCatalog.ts",
    "scaffold:card": "tsx scripts/scaffoldCard.ts",
    "shop:smoke": "tsx scripts/shop-smoke.ts",
    "audit:hud": "tsx scripts/run-hud-audit.ts",
    "audit:cardface": "tsx scripts/card-face-truncation-audit.ts",
    "audit:pl": "tsx scripts/check-balance.ts",
    "art:encode": "tsx scripts/encode-card-art.ts",
    "audio:encode": "tsx scripts/encode-audio.ts",
    "audit:equipment": "tsx scripts/equipment-audit.ts",
    "content:equipment-template": "tsx scripts/equipment-template.ts",
    "audit:equipment-sources": "tsx scripts/equipment-loot-sources-audit.ts",
    "audit:equipment-battle": "tsx scripts/equipment-battle-audit.ts",
    "audit:equipment-share": "tsx scripts/equipment-share-audit.ts",
    "audit:equipment-run": "tsx scripts/equipment-run-audit.ts",
    "audit:battle-passives": "tsx scripts/battle-passives-audit.ts",
    "content:snapshot": "tsx scripts/contentSnapshot.ts",
    "content:sync": "tsx scripts/sync-community-content.ts",
    "content:verify": "tsx scripts/sync-community-content.ts --offline",
    "content:repository-export": "tsx scripts/export-community-repository.ts",
    "audit:content-snapshot": "tsx scripts/content-snapshot-audit.ts",
    "audit:content-sync": "tsx scripts/content-sync-audit.ts",
    "audit:community-repository": "tsx scripts/community-repository-audit.ts",
    "audit:community-inventory": "tsx scripts/community-candidate-inventory-audit.ts",
    "audit:community-art": "tsx scripts/community-art-audit.ts",
    "audit:community-mechanics": "tsx scripts/community-mechanics-audit.ts",
    "audit:community-promotion": "tsx scripts/community-promotion-audit.ts",
    "audit:content-metadata": "tsx scripts/content-build-metadata-audit.ts",
    "audit:community": "tsx scripts/community-store-audit.ts && tsx scripts/community-github-audit.ts && tsx scripts/community-reconcile-audit.ts && tsx scripts/community-implementation-audit.ts && tsx scripts/community-support-audit.ts && tsx scripts/community-rounds-audit.ts && tsx scripts/community-backup-audit.ts && tsx scripts/community-release-audit.ts && tsx scripts/community-points-audit.ts",
    "community:doctor": "tsx scripts/community-automation.ts",
    "audit:community-automation": "tsx scripts/community-automation-audit.ts",
    "audit:community-private-reader": "tsx scripts/community-private-reader-audit.ts",
    "audit:community-github-setup": "tsx scripts/community-github-setup-audit.ts",
    "executors:archive:export": "tsx scripts/export-run-executor-archive.ts",
    "executors:approve-current": "tsx scripts/approve-current-executor.ts",
    "audit:executors-approval": "tsx scripts/approve-current-executor-audit.ts",
    "community:record-release": "tsx scripts/record-community-release.ts",
    "audit:community-remote-release": "tsx scripts/community-remote-release-audit.ts",
    "executors:preflight": "tsx scripts/run-executor-preflight.ts",
    "audit:executors-archive": "tsx scripts/run-executor-archive-audit.ts",
    "audit:community-backup": "tsx scripts/community-backup-audit.ts",
    "audit:online": "tsx scripts/online-intents-audit.ts && tsx scripts/online-executor-audit.ts && tsx scripts/eligible-run-service-audit.ts && tsx scripts/eligible-run-settlement-audit.ts && tsx scripts/eligible-ghost-audit.ts && tsx scripts/run-executor-retention-audit.ts && tsx scripts/run-executor-archive-audit.ts",
    "audit:community-d1": "tsx scripts/community-workerd-audit.ts",
    "audit:community-ui": "tsx scripts/community-screen-audit.ts",
    "audit:eligible-screen": "tsx scripts/eligible-run-phaser-audit.ts",
    "deploy:prepare": "npm run content:sync && node node_modules/tsx/dist/cli.mjs scripts/run-executor-preflight.ts --production && npm run build",
    "build:run-executors": "node node_modules/tsx/dist/cli.mjs scripts/build-run-executors.ts"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.61.1",
    "sharp": "^0.35.5",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
