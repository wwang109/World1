{
  "name": "world1",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Turn-based semi-auto roguelite party battler",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node scripts/check-boundaries.mjs && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "api": "tsx server/battleApi.ts",
    "fight": "tsx scripts/fight.ts",
    "sim": "tsx scripts/balance.ts"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "playwright": "^1.61.1",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
