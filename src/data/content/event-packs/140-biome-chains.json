  "events": [
    {
      "id": "lantern_wake",
      "versions": [
        {
          "version": 1,
          "def": {
            "title": "The Lantern Wake",
            "body": "Mourners line the barrow road with unlit lanterns, one for each soul the Duskbarrow keeps. A lantern lit for the dead is a debt they repay once the barrow's master falls.",
            "theme": "omen",
            "rarity": "uncommon",
            "biomeIds": [
              "duskbarrow"
            ],
            "story": {
              "storyId": "lantern_wake",
              "stage": "setup",
              "role": "setup"
            },
            "eligibility": {
              "fact": "biome.current",
              "args": {
                "ids": [
                  "duskbarrow"
                ]
              }
            },
            "delivery": {
              "kind": "ambient"
            },
            "visibility": "visible",
            "priority": 220,
            "once": "run",
            "cooldownNodes": 0,
            "choiceSet": {
              "fixed": [
                {
                  "id": "light_lantern",
                  "label": "Light a lantern for the dead (1 gold)",
                  "cost": 1,
                  "outcome": {
                    "kind": "nothing"
                  }
                },
                {
                  "id": "take_dark_card",
                  "label": "Take a Dark card (1 gold)",
                  "cost": 1,
                  "outcome": {
                    "kind": "cardChoice",
                    "filter": [
                      {
                        "elements": [
                          "dark"
                        ]
                      }
                    ],
                    "maxTier": "bronze"
                  }
                },
                {
                  "id": "leave",
                  "label": "Walk past the mourners",
                  "cost": 0,
                  "outcome": {
                    "kind": "nothing"
                  }
                }
              ]
            }
          }
        }
      ]
    },
    {
