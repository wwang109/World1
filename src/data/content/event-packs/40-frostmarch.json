{
  "schemaVersion": 3,
  "storyStateSchema": {
    "oath_mercy": { "kind": "boolean", "default": false },
    "grave_path": { "kind": "enum", "values": ["none", "opened", "answered"], "default": "none" },
    "honorable_choice": { "kind": "boolean", "default": false },
    "reliquary_oath": { "kind": "boolean", "default": false },
    "oath_gate": { "kind": "enum", "values": ["none", "sworn", "kept", "released"], "default": "none" },
    "venom_bloom": { "kind": "enum", "values": ["none", "cultivated"], "default": "none" },
    "rival_spared": { "kind": "boolean", "default": false },
    "moon_quarry_released": { "kind": "boolean", "default": false }
  },
  "events": [
    {
      "id": "whiteout_pilgrim",
      "versions": [
        {
          "version": 1,
          "def": {
            "title": "Whiteout Pilgrim",
            "body": "A pilgrim steps out of the Frostmarch white, following a road visible only to those who have won beneath frost's banner.",
            "theme": "training",
            "rarity": "uncommon",
            "biomeIds": ["frostmarch"],
            "story": { "storyId": "whiteout_pilgrim", "stage": "setup", "role": "setup" },
            "eligibility": { "fact": "combat.affinityWin", "args": { "affinityId": "frost", "atLeast": 1, "biomeId": "frostmarch" } },
            "delivery": { "kind": "ambient" },
            "visibility": "visible",
            "priority": 200,
            "once": "run",
            "cooldownNodes": 0,
            "choiceSet": {
              "fixed": [
                {
                  "id": "share_white_road",
                  "label": "Share the white road",
                  "cost": 0,
                  "outcome": { "kind": "cardChoice", "filter": [{ "elements": ["frost"] }], "maxTier": "bronze" },
                  "callback": {
                    "callbackId": "whiteout_guidance",
                    "eventId": "whiteout_guidance",
                    "contentVersion": 1,
                    "minDepthDelay": 2,
                    "destinationThemes": ["training"],
                    "destinationBiomeIds": ["frostmarch"],
                    "priority": 700,
                    "bind": [],
                    "expiry": { "expiresAfterNodes": 12, "fallback": "discard" }
                  }
                },
                {
                  "id": "take_ward",
                  "label": "Take the pilgrim's ward",
                  "cost": 0,
                  "outcome": { "kind": "gemChoice", "filter": [{ "actionKinds": ["shield", "guard", "ward"] }] }
                },
                { "id": "leave", "label": "Return to the road", "cost": 0, "outcome": { "kind": "nothing" } }
              ]
            }
          }
        }
      ]
    },
    {
      "id": "whiteout_guidance",
      "versions": [
        {
          "version": 1,
          "def": {
            "title": "The Pilgrim's Marker",
            "body": "A white-road marker rises where the storm should have erased every trail. The pilgrim's sign points through the safest break in the gale.",
            "theme": "training",
            "rarity": "uncommon",
            "biomeIds": ["frostmarch"],
            "story": { "storyId": "whiteout_pilgrim", "stage": "callback", "role": "callback" },
            "eligibility": { "fact": "callback.queued", "args": { "callbackId": "whiteout_guidance" } },
            "delivery": { "kind": "queued_callback" },
            "visibility": "teased_when_due",
            "priority": 700,
            "once": "run",
            "cooldownNodes": 0,
            "choiceSet": {
              "fixed": [
                {
                  "id": "take_guidance",
                  "label": "Follow the safe line",
                  "cost": 0,
                  "outcome": { "kind": "grantMapInfo", "bandsAhead": 2 },
                  "mutations": [{ "op": "completeStory", "storyId": "whiteout_pilgrim" }]
                },
                {
                  "id": "take_ward",
                  "label": "Claim the cached ward",
                  "cost": 0,
                  "outcome": { "kind": "gemChoice", "filter": [{ "actionKinds": ["shield", "guard", "ward"] }] },
                  "mutations": [{ "op": "completeStory", "storyId": "whiteout_pilgrim" }]
                },
                {
                  "id": "walk_unaided",
                  "label": "Walk unaided",
                  "cost": 0,
                  "outcome": { "kind": "nothing" },
                  "mutations": [{ "op": "completeStory", "storyId": "whiteout_pilgrim" }]
                }
              ]
            }
          }
        }
      ]
    },
    {
      "id": "rime_locked_sledge",
      "versions": [
        {
          "version": 1,
          "def": {
            "title": "Rime-Locked Sledge",
            "body": "A frost-smith's sledge lies half-forged in a block of ice at the Frostmarch's edge, its head shaped for a binding cold that never finished setting.",
            "theme": "forge",
            "rarity": "uncommon",
            "biomeIds": ["frostmarch"],
            "story": { "storyId": "rime_locked_sledge", "stage": "setup", "role": "setup" },
            "eligibility": { "fact": "biome.current", "args": { "ids": ["frostmarch"] } },
            "delivery": { "kind": "ambient" },
            "visibility": "visible",
            "priority": 150,
            "once": "run",
            "cooldownNodes": 0,
            "choiceSet": {
              "fixed": [
                {
                  "id": "take_frost_shackle",
                  "label": "Take Frost Shackle",
                  "cost": 0,
                  "outcome": { "kind": "grantCard", "cardId": "frost_shackle", "tier": "bronze" }
                },
                {
                  "id": "take_frost_card",
                  "label": "Take a Frost card",
                  "cost": 0,
                  "outcome": { "kind": "cardChoice", "filter": [{ "elements": ["frost"] }], "maxTier": "bronze" }
                },
                { "id": "leave", "label": "Leave the sledge frozen", "cost": 0, "outcome": { "kind": "nothing" } }
              ]
            }
          }
        }
      ]
    },
    {
      "id": "hoarfrost_reliquary",
      "versions": [
        {
          "version": 1,
          "def": {
            "title": "Hoarfrost Reliquary",
            "body": "A traveling reliquary keeper has set up a stall of frost-worked wares between two dead pines, each piece rimed white and humming faintly with cold.",
            "theme": "market",
            "rarity": "uncommon",
            "biomeIds": ["frostmarch"],
            "story": { "storyId": "hoarfrost_reliquary", "stage": "setup", "role": "setup" },
            "eligibility": {
              "all": [
                { "fact": "biome.current", "args": { "ids": ["frostmarch"] } },
                { "fact": "owned.card.count", "args": { "where": "any", "count": 1, "match": { "elements": ["frost"] } } }
              ]
            },
            "delivery": { "kind": "ambient" },
            "visibility": "visible",
            "priority": 160,
            "once": "run",
            "cooldownNodes": 0,
            "choiceSet": {
              "fixed": [
                {
                  "id": "buy_reliquary_ware",
                  "label": "Browse the reliquary's wares",
                  "cost": 0,
                  "outcome": { "kind": "gemChoice", "filter": [{ "ids": ["frost_ward_echo", "mana_ward_echo", "stunning_shard"] }] }
                },
                {
                  "id": "rime_a_frost_card",
                  "label": "Rime a Frost card",
                  "cost": 0,
                  "outcome": {
                    "kind": "upgradeCardTargeted",
                    "target": { "filter": { "where": "any", "match": { "elements": ["frost"] } } },
                    "fallback": { "kind": "grantGold", "amount": 2 }
                  }
                },
                { "id": "leave", "label": "Walk past the stall", "cost": 0, "outcome": { "kind": "nothing" } }
              ]
            }
          }
        }
      ]
    }
  ]
}
