{
  "schemaVersion": 3,
  "storyStateSchema": {
    "oath_mercy": { "kind": "boolean", "default": false },
    "grave_path": { "kind": "enum", "values": ["none", "opened", "answered"], "default": "none" },
    "honorable_choice": { "kind": "boolean", "default": false },
    "reliquary_oath": { "kind": "boolean", "default": false },
    "oath_gate": { "kind": "enum", "values": ["none", "sworn", "kept", "released"], "default": "none" },
    "venom_bloom": { "kind": "enum", "values": ["none", "cultivated"], "default": "none" },
    "rival_spared": { "kind": "boolean", "default": false },
    "moon_quarry_released": { "kind": "boolean", "default": false }
  },
  "events": [
    {
      "id": "last_hedge",
      "versions": [
        {
          "version": 1,
          "def": {
            "title": "The Last Hedge",
            "body": "At Pikewold's far boundary, a veteran holds the last living hedge with one weathered lance and a lesson in refusing the road's advance.",
            "theme": "training",
            "rarity": "uncommon",
            "biomeIds": ["pikewold"],
            "story": { "storyId": "last_hedge", "stage": "setup", "role": "setup" },
            "eligibility": {
              "all": [
                { "fact": "owned.card.count", "args": { "where": "any", "count": 1, "match": { "weapons": ["lance"] } } },
                { "fact": "owned.card.count", "args": { "where": "any", "count": 1, "match": { "archetypes": ["defensive"] } } }
              ]
            },
            "delivery": { "kind": "ambient" },
            "visibility": "visible",
            "priority": 200,
            "once": "run",
            "cooldownNodes": 0,
            "choiceSet": {
              "fixed": [
                { "id": "take_lance_lesson", "label": "Take the Lance lesson", "cost": 0, "outcome": { "kind": "cardChoice", "filter": [{ "weapons": ["lance"] }], "maxTier": "bronze" } },
                { "id": "take_hedge_ward", "label": "Take the hedge ward", "cost": 0, "outcome": { "kind": "gemChoice", "filter": [{ "actionKinds": ["shield", "guard", "ward"] }] } },
                { "id": "drill_then_leave", "label": "Drill, then leave", "cost": 0, "outcome": { "kind": "grantLevel" } }
              ]
            }
          }
        }
      ]
    },
    {
      "id": "pike_forge",
      "versions": [
        {
          "version": 1,
          "def": {
            "title": "The Pike-Forge",
            "body": "A field-forge still glows at Pikewold's rear line, its bellows worked by no one and its rack holding a single braced shaft, cooling from the last quench.",
            "theme": "forge",
            "rarity": "uncommon",
            "biomeIds": ["pikewold"],
            "story": { "storyId": "pike_forge", "stage": "setup", "role": "setup" },
            "eligibility": { "fact": "biome.current", "args": { "ids": ["pikewold"] } },
            "delivery": { "kind": "ambient" },
            "visibility": "visible",
            "priority": 150,
            "once": "run",
            "cooldownNodes": 0,
            "choiceSet": {
              "fixed": [
                {
                  "id": "take_braced_pike",
                  "label": "Take the Braced Pike",
                  "cost": 0,
                  "outcome": { "kind": "grantCard", "cardId": "braced_pike", "tier": "bronze" }
                },
                {
                  "id": "take_lance_card",
                  "label": "Take a Lance card",
                  "cost": 0,
                  "outcome": { "kind": "cardChoice", "filter": [{ "weapons": ["lance"] }], "maxTier": "bronze" }
                },
                { "id": "leave", "label": "Let the forge cool", "cost": 0, "outcome": { "kind": "nothing" } }
              ]
            }
          }
        }
      ]
    },
    {
      "id": "drill_sergeant_chest",
      "versions": [
        {
          "version": 1,
          "def": {
            "title": "Drill-Sergeant's Chest",
            "body": "A locked chest sits at the foot of a drill yard long since abandoned, stamped with a dead sergeant's seal and heavy with a lance-hand's due.",
            "theme": "cache",
            "rarity": "uncommon",
            "biomeIds": ["pikewold"],
            "story": { "storyId": "drill_sergeant_chest", "stage": "setup", "role": "setup" },
            "eligibility": {
              "all": [
                { "fact": "biome.current", "args": { "ids": ["pikewold"] } },
                { "fact": "owned.card.count", "args": { "where": "any", "count": 1, "match": { "weapons": ["lance"] } } }
              ]
            },
            "delivery": { "kind": "ambient" },
            "visibility": "visible",
            "priority": 160,
            "once": "run",
            "cooldownNodes": 0,
            "choiceSet": {
              "fixed": [
                {
                  "id": "open_the_chest",
                  "label": "Open the drill-sergeant's chest",
                  "cost": 0,
                  "outcome": { "kind": "gemChoice", "filter": [{ "ids": ["ward_of_silence_echo", "millstone_sliver", "crippling_strike_echo"] }] }
                },
                {
                  "id": "drill_lance_card",
                  "label": "Drill a Lance card",
                  "cost": 0,
                  "outcome": {
                    "kind": "upgradeCardTargeted",
                    "target": { "filter": { "where": "any", "match": { "weapons": ["lance"] } } },
                    "fallback": { "kind": "grantGold", "amount": 2 }
                  }
                },
                { "id": "leave", "label": "Leave the chest locked", "cost": 0, "outcome": { "kind": "nothing" } }
              ]
            }
          }
        }
      ]
    }
  ]
}
