{
  "schemaVersion": 3,
  "storyStateSchema": {
    "oath_mercy": { "kind": "boolean", "default": false },
    "grave_path": { "kind": "enum", "values": ["none", "opened", "answered"], "default": "none" },
    "honorable_choice": { "kind": "boolean", "default": false },
    "reliquary_oath": { "kind": "boolean", "default": false },
    "oath_gate": { "kind": "enum", "values": ["none", "sworn", "kept", "released"], "default": "none" },
    "venom_bloom": { "kind": "enum", "values": ["none", "cultivated"], "default": "none" },
    "rival_spared": { "kind": "boolean", "default": false },
    "moon_quarry_released": { "kind": "boolean", "default": false }
  },
  "events": [
    {
      "id": "bloom_behind_the_teeth",
      "versions": [
        {
          "version": 1,
          "def": {
            "title": "Bloom Behind the Teeth",
            "body": "Past Thornwild's poisoned crown, a flower opens inside the jaw of a stone beast. It knows the nature-bound hand that carried venom through a ruler's fall.",
            "theme": "cache",
            "rarity": "secret",
            "biomeIds": ["thornwild"],
            "story": { "storyId": "bloom_behind_the_teeth", "stage": "capstone", "role": "capstone" },
            "eligibility": {
              "all": [
                { "fact": "combat.statusUsed", "args": { "status": "poison", "result": "bossWin", "biomeId": "thornwild" } },
                { "fact": "board.affinity", "args": { "affinityId": "nature" } }
              ]
            },
            "delivery": { "kind": "ambient" },
            "visibility": "hidden_until_eligible",
            "priority": 400,
            "once": "run",
            "cooldownNodes": 0,
            "choiceSet": {
              "fixed": [
                { "id": "harvest_venom", "label": "Harvest the venom", "cost": 0, "outcome": { "kind": "gemChoice", "filter": [{ "actionKinds": ["poison"] }, { "ids": ["festering_sliver"] }] } },
                {
                  "id": "cultivate_bloom",
                  "label": "Cultivate the bloom",
                  "cost": 0,
                  "outcome": {
                    "kind": "upgradeCardTargeted",
                    "target": { "filter": { "where": "any", "match": { "elements": ["nature"] } } },
                    "fallback": { "kind": "grantGold", "amount": 2 }
                  },
                  "mutations": [{ "op": "set", "key": "venom_bloom", "value": "cultivated" }]
                },
                { "id": "leave", "label": "Leave the bloom sleeping", "cost": 0, "outcome": { "kind": "nothing" } }
              ]
            }
          }
        }
      ]
    },
    {
      "id": "rootbound_hermit",
      "versions": [
        {
          "version": 1,
          "def": {
            "title": "The Rootbound Hermit",
            "body": "A hermit sits half-grown into Thornwild's tangle, bark climbing one arm and thorns threading through their hair. They offer to walk with you, if you'll carry the thorn they can no longer wield.",
            "theme": "recruit",
            "rarity": "uncommon",
            "biomeIds": ["thornwild"],
            "story": { "storyId": "rootbound_hermit", "stage": "setup", "role": "setup" },
            "eligibility": { "fact": "biome.current", "args": { "ids": ["thornwild"] } },
            "delivery": { "kind": "ambient" },
            "visibility": "visible",
            "priority": 150,
            "once": "run",
            "cooldownNodes": 0,
            "choiceSet": {
              "fixed": [
                {
                  "id": "take_thorn_bite",
                  "label": "Take Thorn Bite",
                  "cost": 0,
                  "outcome": { "kind": "grantCard", "cardId": "thorn_bite", "tier": "bronze" }
                },
                {
                  "id": "take_nature_card",
                  "label": "Take a Nature card",
                  "cost": 0,
                  "outcome": { "kind": "cardChoice", "filter": [{ "elements": ["nature"] }], "maxTier": "bronze" }
                },
                { "id": "leave", "label": "Leave the hermit rooted", "cost": 0, "outcome": { "kind": "nothing" } }
              ]
            }
          }
        }
      ]
    },
    {
      "id": "seedvault",
      "versions": [
        {
          "version": 1,
          "def": {
            "title": "The Seedvault",
            "body": "A stone vault stands sealed beneath Thornwild's oldest tree, its lid grown shut with roots. Inside, a keeper's hoard of seeds waits for a nature-tempered hand to crack it open.",
            "theme": "market",
            "rarity": "uncommon",
            "biomeIds": ["thornwild"],
            "story": { "storyId": "seedvault", "stage": "setup", "role": "setup" },
            "eligibility": {
              "all": [
                { "fact": "biome.current", "args": { "ids": ["thornwild"] } },
                { "fact": "owned.card.count", "args": { "where": "any", "count": 1, "match": { "elements": ["nature"] } } }
              ]
            },
            "delivery": { "kind": "ambient" },
            "visibility": "visible",
            "priority": 160,
            "once": "run",
            "cooldownNodes": 0,
            "choiceSet": {
              "fixed": [
                {
                  "id": "crack_the_seedvault",
                  "label": "Crack the seedvault",
                  "cost": 0,
                  "outcome": { "kind": "gemChoice", "filter": [{ "ids": ["bramble_sliver", "second_wind_echo", "renewal_sliver"] }] }
                },
                {
                  "id": "root_nature_card",
                  "label": "Root a Nature card",
                  "cost": 0,
                  "outcome": {
                    "kind": "upgradeCardTargeted",
                    "target": { "filter": { "where": "any", "match": { "elements": ["nature"] } } },
                    "fallback": { "kind": "grantGold", "amount": 2 }
                  }
                },
                { "id": "leave", "label": "Leave the vault rooted shut", "cost": 0, "outcome": { "kind": "nothing" } }
              ]
            }
          }
        }
      ]
    }
  ]
}
